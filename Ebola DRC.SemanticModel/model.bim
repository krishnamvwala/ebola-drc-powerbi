            "sourceColumn": "Days since previous report",
            "summarizeBy": "none"
          },
          {
            "name": "Source",
            "dataType": "string",
            "lineageTag": "3fa0f4e1-3193-4ec0-8adc-6a912b0ddd5b",
            "sourceColumn": "Source",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "ce469917-e6a8-4239-8bc2-ca06a300ab0e",
        "measures": [
          {
            "name": "Reported cases",
            "description": "Latest observation in the filter context. Never sums cumulative counts over time.",
            "expression": "VAR SnapshotDate = MAX('National'[Report date]) RETURN CALCULATE(MAX('National'[Cumulative cases]), 'National'[Report date] = SnapshotDate)",
            "formatString": "#,0",
            "lineageTag": "fede3b67-c108-4f0d-a7fb-1e7225f6761c"
          },
          {
            "name": "Reported deaths",
            "expression": "VAR SnapshotDate = MAX('National'[Report date]) RETURN CALCULATE(MAX('National'[Cumulative deaths]), 'National'[Report date] = SnapshotDate)",
            "formatString": "#,0",
            "lineageTag": "9a3a754b-994e-405a-ae74-7f8627fddad7"
          },
          {
            "name": "Reporting observations",
            "expression": "COUNTROWS('National')",
            "formatString": "#,0",
            "lineageTag": "5a9ea281-9426-4047-a0f6-f7874ae658e3"
          },
          {
            "name": "Longest reporting gap",
            "expression": "MAX('National'[Days since previous report])",
            "formatString": "#,0",
            "lineageTag": "e95e86ab-cc2e-464e-ab83-f82f32954fb4"
          }
        ],
        "partitions": [
          {
            "name": "National",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"national_reports.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Report date\", type date}, {\"Publication date\", type date}, {\"Confirmed cases\", Int64.Type}, {\"Probable cases\", Int64.Type}, {\"Cumulative cases\", Int64.Type}, {\"Cumulative deaths\", Int64.Type}, {\"Cumulative recoveries\", Int64.Type}, {\"Net case change\", Int64.Type}, {\"Net death change\", Int64.Type}, {\"Days since previous report\", Int64.Type}, {\"Source\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
