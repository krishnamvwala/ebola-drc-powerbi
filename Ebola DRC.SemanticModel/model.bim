        "measures": [
          {
            "name": "Final cases",
            "description": "WHO final total, as of 25 June 2020.",
            "expression": "SUM('WHO final'[Total cases])",
            "formatString": "#,0",
            "lineageTag": "313f8609-1078-4ee5-8037-db3fe33cc230"
          },
          {
            "name": "Final deaths",
            "expression": "SUM('WHO final'[Deaths])",
            "formatString": "#,0",
            "lineageTag": "f2a3b191-0ff3-46b1-9c9b-799f7263420a"
          },
          {
            "name": "Final case fatality ratio",
            "description": "Reported deaths divided by confirmed plus probable cases, same final date.",
            "expression": "DIVIDE([Final deaths], [Final cases])",
            "formatString": "0.0%",
            "lineageTag": "fca61030-e42b-4b1a-9261-20b6d65ec659"
          },
          {
            "name": "Final affected health zones",
            "expression": "MAX('WHO final'[Affected health zones])",
            "formatString": "#,0",
            "lineageTag": "a729bfdb-6d68-49e4-b7a9-1c1e863501a7"
          },
          {
            "name": "Final confirmed",
            "expression": "SUM('WHO final'[Confirmed cases])",
            "formatString": "#,0",
            "lineageTag": "b69158f0-87db-48ec-ae80-8f2c3344759f"
          },
          {
            "name": "Final probable",
            "expression": "SUM('WHO final'[Probable cases])",
            "formatString": "#,0",
            "lineageTag": "2f939615-e35f-4e15-867b-8e3dc967bcad"
          }
