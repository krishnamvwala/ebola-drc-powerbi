            "formatString": "#,0",
            "lineageTag": "7afa33dc-69b9-4167-8d2d-b13066ba003d",
            "sourceColumn": "Interval days",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "68e1601c-a8d4-4da7-9f8f-93b06f686d75",
        "measures": [
          {
            "name": "Net reported cases",
            "description": "Net changes between reporting snapshots, including negative retrospective revisions and the opening balance. Not an onset-date incidence curve.",
            "expression": "SUM('Case changes'[Net case change])",
            "formatString": "#,0",
            "lineageTag": "3f9fcde6-537f-4a49-bb66-ea172136ac54"
          },
          {
            "name": "Confirmed case changes",
            "expression": "CALCULATE([Net reported cases], KEEPFILTERS('Case changes'[Case classification] = \"Confirmed\"))",
            "formatString": "#,0",
            "lineageTag": "21f186b2-7b3e-4977-9baf-aa635d304ddc"
          },
          {
            "name": "Probable case changes",
            "expression": "CALCULATE([Net reported cases], KEEPFILTERS('Case changes'[Case classification] = \"Probable\"))",
            "formatString": "#,0",
            "lineageTag": "704288a3-e237-4bc2-8be3-442b607237f0"
          },
          {
            "name": "Negative revision records",
            "expression": "CALCULATE(COUNTROWS('Case changes'), 'Case changes'[Is negative revision] = 1)",
            "formatString": "#,0",
            "lineageTag": "bd7ff491-3246-4b30-9f10-15b3fbe54605"
          },
          {
            "name": "Health zones in selection",
            "expression": "DISTINCTCOUNT('Case changes'[Zone key])",
            "formatString": "#,0",
            "lineageTag": "39339f0a-7320-4e5e-8a89-e5f52aba4934"
          }
        ],
        "partitions": [
          {
            "name": "Case changes",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"health_zone_case_changes.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Report date\", type date}, {\"Previous report date\", type date}, {\"Period label\", type text}, {\"Zone key\", type text}, {\"Case classification\", type text}, {\"Net case change\", Int64.Type}, {\"Is negative revision\", Int64.Type}, {\"Is opening balance\", Int64.Type}, {\"Interval days\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
