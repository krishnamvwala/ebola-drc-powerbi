          },
          {
            "name": "Is negative revision",
            "dataType": "int64",
            "formatString": "#,0",
            "lineageTag": "cd879663-d06c-4816-9b1e-2224f701a3a5",
            "sourceColumn": "Is negative revision",
            "summarizeBy": "none"
          },
          {
            "name": "Is opening balance",
            "dataType": "int64",
            "formatString": "#,0",
            "lineageTag": "aa8ae5c0-ff64-43d3-87ad-83ed94dab2b5",
            "sourceColumn": "Is opening balance",
